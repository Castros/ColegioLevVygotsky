# dns-route53.tf.example
# Rename to dns-route53.tf to have Terraform manage the DNS record in AWS Route 53.
# Requires: aws provider added to main.tf + AWS credentials in tfvars.

# Add to terraform {} block in main.tf:
#   aws = {
#     source  = "hashicorp/aws"
#     version = "~> 5.0"
#   }

# Add to main.tf providers:
#   provider "aws" {
#     region     = var.aws_region
#     access_key = var.aws_access_key
#     secret_key = var.aws_secret_key
#   }

data "aws_route53_zone" "main" {
  name         = var.domain
  private_zone = false
}

resource "aws_route53_record" "strapi" {
  zone_id = data.aws_route53_zone.main.zone_id
  name    = "${var.subdomain}.${var.domain}"
  type    = "A"
  ttl     = 300
  records = [digitalocean_droplet.strapi.ipv4_address]
}

# Add these to variables.tf when using this file:
#
# variable "domain" {
#   description = "Root domain in Route 53 (e.g. vigotskyreynosa.edu.mx)"
#   type        = string
# }
# variable "subdomain" {
#   description = "Subdomain for Strapi (e.g. cms-staging)"
#   type        = string
# }
# variable "aws_region" {
#   type    = string
#   default = "us-east-1"
# }
# variable "aws_access_key" {
#   type      = string
#   sensitive = true
# }
# variable "aws_secret_key" {
#   type      = string
#   sensitive = true
# }
